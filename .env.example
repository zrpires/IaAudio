# Sem chave, o assistente usa regras locais e identifica esse modo na tela.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Obrigatório para liberar chamadas pagas da IA. Não use prefixo NEXT_PUBLIC_.
APP_PASSWORD=
PORT=3000


# Transcrição independente do serviço do navegador. Pode usar chave separada
# sem ativar a IA generativa do chat. Requer APP_PASSWORD e saldo na API.
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=gpt-transcribe
